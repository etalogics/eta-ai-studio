# Local-only simulation. Live generation is intentionally unavailable in this milestone.
PORT=4310
STUDIO_DATA_DIR=./data
STUDIO_PROVIDER=higgsfield
# Complete copied REST credential from open.higgsfield.ai/api-keys.
# Server-only. Never prefix with Key here, expose to the browser, or commit it.
HF_API_KEY=
# Alternative SDK-style pair; complete HF_API_KEY takes precedence.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Exact approved API model path, once its input schema has been verified.
# Configuration alone does not enable live generation in this simulation build.
STUDIO_APPROVED_MODEL=
